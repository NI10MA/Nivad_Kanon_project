# Copy to .env (or export these variables) before running.
# نمونه‌ی تنظیمات محیطی؛ این فایل را به .env کپی کرده و مقادیر را تغییر دهید.
# کلید مخفی جنگو: در محیط واقعی حتماً یک رشته‌ی طولانی و تصادفی بگذارید.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# حالت توسعه (۱ = روشن، ۰ = خاموش)؛ در سرور واقعی ۰ باشد.
DJANGO_DEBUG=1
# دامنه‌های مجاز (با ویرگول جدا شوند)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL (default). For quick local tests without MySQL set DB_ENGINE=sqlite
# نوع دیتابیس: mysql یا sqlite (sqlite فقط برای تست سریع محلی)
DB_ENGINE=mysql
# اطلاعات اتصال به MySQL
DB_NAME=nivad_kanon
DB_USER=nivad
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
